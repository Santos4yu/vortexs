{
  "manifest_version": 3,
  "name": "CS2 Prop Lab Collector",
  "version": "0.2.0",
  "description": "Captures PrizePicks lines and visible HLTV/bo3.gg map statistics for CS2 Prop Lab.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms"],
  "host_permissions": ["https://*.prizepicks.com/*", "https://*.hltv.org/*", "https://hltv.org/*", "https://*.bo3.gg/*", "https://bo3.gg/*", "http://localhost/*", "https://*.openai.site/*"],
  "action": {
    "default_title": "Send CS2 board",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["http://localhost/*", "https://*.openai.site/*"],
    "js": ["bridge.js"],
    "run_at": "document_idle"
  }]
}
